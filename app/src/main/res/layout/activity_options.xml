<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Options"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <!-- HOLIDAYS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Show Holidays"
                android:textColor="#FFFFFF"
                android:textSize="18sp"/>

            <Switch
                android:id="@+id/switchHolidays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="@color/switch_thumb"
                android:trackTint="@color/switch_track"/>

        </LinearLayout>

        <!-- HIDE FUTURE EVENTS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hide Future Events"
                android:textColor="#FFFFFF"
                android:textSize="18sp"/>

            <Switch
                android:id="@+id/switchHideFuture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="@color/switch_thumb"
                android:trackTint="@color/switch_track"/>

        </LinearLayout>

        <!-- DAYS TO SHOW -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Days to show ahead"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnDaysDown"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="−"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#333333"
                android:padding="0dp"/>

            <TextView
                android:id="@+id/tvDaysCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="7"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <Button
                android:id="@+id/btnDaysUp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="+"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#333333"
                android:padding="0dp"/>

        </LinearLayout>

        <!-- SAVE BUTTON -->
        <Button
            android:id="@+id/btnSaveOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#2a4a7a"/>

        <Button
            android:id="@+id/btnCancelOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#444444"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

</ScrollView>